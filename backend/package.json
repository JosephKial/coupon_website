{
  "name": "family-coupon-manager-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "test:integration": "vitest --run --config vitest.integration.config.ts",
    "test:security": "vitest --run src/test/security.test.ts",
    "test:database": "vitest --run src/test/database.integration.test.ts",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts --fix",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:reset-data": "tsx src/scripts/reset-db.ts",
    "db:check": "tsx src/scripts/migrate.ts",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:push && npm run db:generate && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.30.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "csrf": "^3.1.0",
    "dompurify": "^3.2.7",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "redis": "^4.6.0",
    "validator": "^13.15.15",
    "winston": "^3.8.0",
    "xss": "^1.0.15",
    "zod": "^3.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^18.14.0",
    "@types/supertest": "^2.0.0",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "@vitest/ui": "^0.28.0",
    "eslint": "^8.34.0",
    "prisma": "^5.0.0",
    "supertest": "^6.3.0",
    "tsx": "^3.12.0",
    "typescript": "^4.9.0",
    "vitest": "^0.28.0"
  }
}
